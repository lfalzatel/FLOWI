rules_version = '2';

// Reglas de Firestore del proyecto propio de FLOWI (flowi-9af82).
// OJO: se publican SOLO con  firebase deploy --config firebase.firestore.json --project flowi-9af82 --only firestore
// (nunca en tienda-38d40, que comparte base de datos con la app de la tienda).
//
// Cada persona solo puede ver y cambiar sus propios datos. El rol "admin" solo lo puede
// asignar otro administrador desde "Gestionar usuarios"; nadie puede dárselo a sí mismo.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // Documentos de las colecciones fl_*: el dueño es el campo userId
    function ownsExisting() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function createsOwn() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    // ── Perfiles ──────────────────────────────────────────────
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Al crear el perfil no se puede nacer administrador
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('role', 'Usuario') != 'admin'
        && !request.resource.data.keys().hasAny(['premiumUntil', 'plan']);

      allow update: if signedIn() && (
        // La persona edita su perfil, pero sin tocar su rol
        (request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'premiumUntil', 'plan']))
        // Un administrador solo cambia el rol de otros (o el suyo)
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']))
      );

      allow delete: if false;
    }

    // ── Pagos de planes: solo el servidor (Wompi) los escribe; cada quien lee los suyos
    match /fl_payments/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ── Pagos por transferencia: la persona envía su comprobante (pendiente); solo el servidor
    // (revisarPagoManual, llamado por el administrador) lo aprueba o rechaza
    match /fl_manual_payments/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if createsOwn()
        && request.resource.data.status == 'PENDING'
        && request.resource.data.plan in ['mensual', 'trimestral', 'anual']
        && request.resource.data.image is string
        && request.resource.data.image.size() < 900000
        && request.resource.data.keys().hasOnly(['userId', 'userName', 'userEmail', 'plan', 'amount', 'image', 'note', 'status', 'createdAt']);
      allow update, delete: if false;
    }

    // ── Datos de cada persona ─────────────────────────────────
    match /fl_expenses/{id} {
      // El administrador puede LEER (no cambiar ni borrar) para ver los totales en Gestionar usuarios
      allow read: if ownsExisting() || isAdmin();
      allow delete: if ownsExisting();
      allow create: if createsOwn();
      allow update: if ownsExisting() && request.resource.data.userId == resource.data.userId;
    }

    match /fl_debts/{id} {
      // El administrador puede LEER (no cambiar ni borrar) para ver los totales en Gestionar usuarios
      allow read: if ownsExisting() || isAdmin();
      allow delete: if ownsExisting();
      allow create: if createsOwn();
      allow update: if ownsExisting() && request.resource.data.userId == resource.data.userId;
    }

    match /fl_customCategories/{id} {
      allow read, delete: if ownsExisting();
      allow create: if createsOwn();
      allow update: if ownsExisting() && request.resource.data.userId == resource.data.userId;
    }

    match /fl_notes/{id} {
      allow read, delete: if ownsExisting();
      allow create: if createsOwn();
      allow update: if ownsExisting() && request.resource.data.userId == resource.data.userId;
    }

    match /fl_reminders/{id} {
      allow read, delete: if ownsExisting();
      allow create: if createsOwn();
      allow update: if ownsExisting() && request.resource.data.userId == resource.data.userId;
    }

    match /fl_goals/{id} {
      allow read, delete: if ownsExisting();
      allow create: if createsOwn();
      allow update: if ownsExisting() && request.resource.data.userId == resource.data.userId;
    }

    match /fl_investments/{id} {
      allow read, delete: if ownsExisting();
      allow create: if createsOwn();
      allow update: if ownsExisting() && request.resource.data.userId == resource.data.userId;
    }

    match /fl_accounts/{id} {
      allow read, delete: if ownsExisting();
      allow create: if createsOwn();
      allow update: if ownsExisting() && request.resource.data.userId == resource.data.userId;
    }

    match /fl_transfers/{id} {
      allow read, delete: if ownsExisting();
      allow create: if createsOwn();
      allow update: if ownsExisting() && request.resource.data.userId == resource.data.userId;
    }

    // ── Amigos ────────────────────────────────────────────────
    // Perfil público mínimo: nombre, foto y @usuario (nada de gastos, saldos ni correo).
    function validPublicProfile() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.username is string && d.username.size() <= 40
        && (d.photo == null || (d.photo is string && d.photo.size() <= 600));
    }

    // Lo puede ver quien tenga sesión (para el enlace de invitación); solo el dueño lo escribe
    match /fl_profiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == uid && validPublicProfile()
        && request.resource.data.keys().hasOnly(['name', 'photo', 'username', 'searchable', 'updatedAt'])
        && request.resource.data.searchable is bool;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Buscador: solo están quienes dejan que los encuentren por el nombre
    match /fl_directory/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid && validPublicProfile()
        && request.resource.data.keys().hasOnly(['name', 'photo', 'username', 'prefixes', 'updatedAt'])
        && request.resource.data.prefixes is list && request.resource.data.prefixes.size() <= 80;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Solicitudes de amistad: id = "{de}_{para}". Las ven solo las dos personas.
    // La envía quien la crea; solo la persona que la recibe la acepta o la rechaza; cualquiera de las dos la borra
    // (cancelar una solicitud o eliminar a un amigo).
    match /fl_friend_requests/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.users == [request.auth.uid, request.resource.data.to]
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['from', 'to', 'users', 'status', 'fromName', 'fromPhoto', 'fromUsername',
             'toName', 'toPhoto', 'toUsername', 'createdAt'])
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 60
        && request.resource.data.toName is string && request.resource.data.toName.size() <= 60;
      allow update: if signedIn()
        && resource.data.to == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']);
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    // ── Gastos compartidos entre amigos (lib/sharedLinks.ts) ──
    // id = "{gasto}_{amigo}". Lo crea quien pagó (con un gasto suyo y solo con un amigo aceptado).
    // Los dos lo ven; cada uno cambia solo lo suyo: quien pagó, los datos del gasto; el amigo, si lo acepta.
    // Los abonos los pueden anotar los dos (los mismos que se ven en la app de cada uno).
    function friendsAccepted(a, b) {
      let ab = /databases/$(database)/documents/fl_friend_requests/$(a + '_' + b);
      let ba = /databases/$(database)/documents/fl_friend_requests/$(b + '_' + a);
      return (exists(ab) && get(ab).data.status == 'accepted') || (exists(ba) && get(ba).data.status == 'accepted');
    }

    // ── Bloquear contacto y reportar (lib/chatSafety.ts) ──
    // fl_blocks/{quien bloquea}_{bloqueado}: mientras exista, ninguno le puede escribir al otro. Solo lo ve quien bloquea.
    function notBlocked(a, b) {
      return !exists(/databases/$(database)/documents/fl_blocks/$(a + '_' + b))
        && !exists(/databases/$(database)/documents/fl_blocks/$(b + '_' + a));
    }

    match /fl_blocks/{id} {
      allow read: if signedIn() && resource.data.blocker == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['blocker', 'blocked', 'createdAt'])
        && request.resource.data.blocker == request.auth.uid
        && request.resource.data.blocked is string && request.resource.data.blocked != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.blocked;
      allow delete: if signedIn() && resource.data.blocker == request.auth.uid;
    }

    // fl_reports: la persona reporta a otra (con los mensajes que recibió de ella); solo el administrador los lee.
    match /fl_reports/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporter', 'reporterName', 'reported', 'reportedName', 'chatId', 'reason', 'details', 'messages', 'status', 'createdAt'])
        && request.resource.data.reporter == request.auth.uid
        && request.resource.data.reported is string && request.resource.data.reported != request.auth.uid
        && request.auth.uid in request.resource.data.chatId.split('_')
        && request.resource.data.reason in ['acoso', 'estafa', 'spam', 'inapropiado', 'otro']
        && request.resource.data.details is string && request.resource.data.details.size() <= 500
        && request.resource.data.messages is list && request.resource.data.messages.size() <= 20
        && request.resource.data.status == 'nuevo';
    }

    // ── Chat entre amigos (lib/chat.ts) ──
    // id = "{a}_{b}" (los dos uid en orden). Solo los dos lo leen. Para escribir hay que ser amigos aceptados.
    // Cada mensaje: { from, text, createdAt, expiresAt? } y no se puede editar; quien lo escribió lo puede borrar.
    // ttl = duración de los mensajes temporales (0, 24 h, 7 días o 90 días); un cambio deja un aviso (kind 'ttl').
    function chatKeys() { return ['users', 'lastText', 'lastFrom', 'lastAt', 'lastExpiresAt', 'read', 'ttl']; }
    function validChatTtl(d) { return !('ttl' in d) || d.ttl in [0, 86400, 604800, 7776000]; }
    function validChatLast(d) {
      return !('lastFrom' in d) || (d.lastFrom == request.auth.uid && d.lastText is string && d.lastText.size() <= 140);
    }

    match /fl_chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(chatKeys())
        && request.resource.data.users is list && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users[0] < request.resource.data.users[1]
        && chatId == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && validChatLast(request.resource.data) && validChatTtl(request.resource.data)
        && friendsAccepted(request.resource.data.users[0], request.resource.data.users[1])
        && notBlocked(request.resource.data.users[0], request.resource.data.users[1]);
      allow update: if signedIn() && request.auth.uid in resource.data.users
        && request.resource.data.keys().hasOnly(chatKeys())
        && request.resource.data.users == resource.data.users
        && request.resource.data.get('read', {}) is map
        && validChatTtl(request.resource.data)
        // Marcar como leído: solo cambia "read". Mensaje nuevo o cambio de duración: lo hace la persona y siguen siendo amigos.
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
            || ((!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastFrom', 'lastText'])
                 || request.resource.data.lastFrom == request.auth.uid)
                && validChatLast(request.resource.data)
                && friendsAccepted(resource.data.users[0], resource.data.users[1])
                && notBlocked(resource.data.users[0], resource.data.users[1])));

      match /messages/{msgId} {
        allow read: if signedIn() && request.auth.uid in chatId.split('_');
        allow create: if signedIn()
          && request.auth.uid in chatId.split('_')
          && request.resource.data.keys().hasOnly(['from', 'text', 'createdAt', 'expiresAt', 'kind', 'ttl'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 1000
          // Un mensaje lleva texto; el aviso de cambio de duración no
          && (request.resource.data.get('kind', '') == 'ttl'
              ? (request.resource.data.text == '' && request.resource.data.ttl in [0, 86400, 604800, 7776000])
              : (request.resource.data.text.size() > 0 && !('ttl' in request.resource.data)))
          && (!('expiresAt' in request.resource.data) || request.resource.data.expiresAt is timestamp)
          && request.resource.data.createdAt == request.time
          && friendsAccepted(chatId.split('_')[0], chatId.split('_')[1])
          && notBlocked(chatId.split('_')[0], chatId.split('_')[1]);
        allow delete: if signedIn() && resource.data.from == request.auth.uid;
      }
    }

    match /fl_shared_links/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.friend is string
        && request.resource.data.friend != request.auth.uid
        && request.resource.data.users == [request.auth.uid, request.resource.data.friend]
        && request.resource.data.txId is string
        && id == request.resource.data.txId + '_' + request.resource.data.friend
        && request.resource.data.status == 'pending'
        && request.resource.data.share is number && request.resource.data.share >= 0
        && request.resource.data.keys().hasOnly(['owner', 'friend', 'users', 'ownerName', 'friendName', 'txId', 'friendTxId',
             'description', 'category', 'date', 'share', 'status', 'payments', 'removed', 'absorbed', 'createdAt', 'updatedAt'])
        && get(/databases/$(database)/documents/fl_expenses/$(request.resource.data.txId)).data.userId == request.auth.uid
        && friendsAccepted(request.auth.uid, request.resource.data.friend);
      allow update: if signedIn()
        && request.resource.data.payments is list && request.resource.data.payments.size() <= 200
        && (
          // Quien pagó: los datos del gasto, los abonos y lo que asumió; o marcarlo como borrado
          (resource.data.owner == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['description', 'category', 'date', 'share', 'status', 'payments', 'removed', 'absorbed', 'updatedAt'])
            && (request.resource.data.status == resource.data.status || request.resource.data.status == 'deleted'))
          // El amigo: aceptarlo o rechazarlo, sus abonos y el gasto que se creó en su app
          || (resource.data.friend == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'friendTxId', 'payments', 'removed', 'updatedAt'])
            && (request.resource.data.status == resource.data.status
                || (resource.data.status == 'pending' && request.resource.data.status in ['accepted', 'rejected'])
                || (resource.data.status == 'accepted' && request.resource.data.status == 'rejected')))
        );
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }

    // ── Comentarios y sugerencias (lib/feedback.ts) ──
    // Cada persona envía y ve los suyos; el administrador los ve todos, los marca, responde y borra.
    match /fl_feedback/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if createsOwn()
        && request.resource.data.keys().hasOnly(['userId', 'userName', 'type', 'area', 'rating', 'text', 'status', 'reply', 'createdAt'])
        && request.resource.data.type in ['gusta', 'mejorar', 'idea', 'error']
        && request.resource.data.area is string && request.resource.data.area.size() <= 40
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.userName is string && request.resource.data.userName.size() <= 60
        && (request.resource.data.rating == null || (request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5))
        && request.resource.data.status == 'nuevo'
        && request.resource.data.reply == null;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reply'])
        && request.resource.data.status in ['nuevo', 'visto', 'hecho']
        && (request.resource.data.reply == null || (request.resource.data.reply is string && request.resource.data.reply.size() <= 500));
      allow delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Todo lo demás queda cerrado
  }
}
