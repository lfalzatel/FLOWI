rules_version = '2';

// Reglas de Firestore del proyecto propio de FLOWI (flowi-9af82).
// OJO: se publican SOLO con  firebase deploy --config firebase.firestore.json --project flowi-9af82 --only firestore
// (nunca en tienda-38d40, que comparte base de datos con la app de la tienda).
//
// Cada persona solo puede ver y cambiar sus propios datos. El rol "admin" solo lo puede
// asignar otro administrador desde "Gestionar usuarios"; nadie puede dárselo a sí mismo.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // Documentos de las colecciones fl_*: el dueño es el campo userId
    function ownsExisting() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function createsOwn() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    // ── Perfiles ──────────────────────────────────────────────
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Al crear el perfil no se puede nacer administrador
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('role', 'Usuario') != 'admin'
        && !request.resource.data.keys().hasAny(['premiumUntil', 'plan']);

      allow update: if signedIn() && (
        // La persona edita su perfil, pero sin tocar su rol
        (request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'premiumUntil', 'plan']))
        // Un administrador solo cambia el rol de otros (o el suyo)
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']))
      );

      allow delete: if false;
    }

    // ── Pagos de planes: solo el servidor (Wompi) los escribe; cada quien lee los suyos
    match /fl_payments/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ── Pagos por transferencia: la persona envía su comprobante (pendiente); solo el servidor
    // (revisarPagoManual, llamado por el administrador) lo aprueba o rechaza
    match /fl_manual_payments/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if createsOwn()
        && request.resource.data.status == 'PENDING'
        && request.resource.data.plan in ['mensual', 'trimestral', 'anual']
        && request.resource.data.image is string
        && request.resource.data.image.size() < 900000
        && request.resource.data.keys().hasOnly(['userId', 'userName', 'userEmail', 'plan', 'amount', 'image', 'note', 'status', 'createdAt']);
      allow update, delete: if false;
    }

    // ── Datos de cada persona ─────────────────────────────────
    match /fl_expenses/{id} {
      // El administrador puede LEER (no cambiar ni borrar) para ver los totales en Gestionar usuarios
      allow read: if ownsExisting() || isAdmin();
      allow delete: if ownsExisting();
      allow create: if createsOwn();
      allow update: if ownsExisting() && request.resource.data.userId == resource.data.userId;
    }

    match /fl_debts/{id} {
      // El administrador puede LEER (no cambiar ni borrar) para ver los totales en Gestionar usuarios
      allow read: if ownsExisting() || isAdmin();
      allow delete: if ownsExisting();
      allow create: if createsOwn();
      allow update: if ownsExisting() && request.resource.data.userId == resource.data.userId;
    }

    match /fl_customCategories/{id} {
      allow read, delete: if ownsExisting();
      allow create: if createsOwn();
      allow update: if ownsExisting() && request.resource.data.userId == resource.data.userId;
    }

    match /fl_notes/{id} {
      allow read, delete: if ownsExisting();
      allow create: if createsOwn();
      allow update: if ownsExisting() && request.resource.data.userId == resource.data.userId;
    }

    match /fl_reminders/{id} {
      allow read, delete: if ownsExisting();
      allow create: if createsOwn();
      allow update: if ownsExisting() && request.resource.data.userId == resource.data.userId;
    }

    match /fl_goals/{id} {
      allow read, delete: if ownsExisting();
      allow create: if createsOwn();
      allow update: if ownsExisting() && request.resource.data.userId == resource.data.userId;
    }

    match /fl_investments/{id} {
      allow read, delete: if ownsExisting();
      allow create: if createsOwn();
      allow update: if ownsExisting() && request.resource.data.userId == resource.data.userId;
    }

    match /fl_accounts/{id} {
      allow read, delete: if ownsExisting();
      allow create: if createsOwn();
      allow update: if ownsExisting() && request.resource.data.userId == resource.data.userId;
    }

    match /fl_transfers/{id} {
      allow read, delete: if ownsExisting();
      allow create: if createsOwn();
      allow update: if ownsExisting() && request.resource.data.userId == resource.data.userId;
    }

    // ── Amigos ────────────────────────────────────────────────
    // Perfil público mínimo: nombre, foto y @usuario (nada de gastos, saldos ni correo).
    function validPublicProfile() {
      let d = request.resource.data;
      return d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.username is string && d.username.size() <= 40
        && (d.photo == null || (d.photo is string && d.photo.size() <= 600));
    }

    // Lo puede ver quien tenga sesión (para el enlace de invitación); solo el dueño lo escribe
    match /fl_profiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == uid && validPublicProfile()
        && request.resource.data.keys().hasOnly(['name', 'photo', 'username', 'searchable', 'updatedAt'])
        && request.resource.data.searchable is bool;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Buscador: solo están quienes dejan que los encuentren por el nombre
    match /fl_directory/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid && validPublicProfile()
        && request.resource.data.keys().hasOnly(['name', 'photo', 'username', 'prefixes', 'updatedAt'])
        && request.resource.data.prefixes is list && request.resource.data.prefixes.size() <= 80;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Solicitudes de amistad: id = "{de}_{para}". Las ven solo las dos personas.
    // La envía quien la crea; solo la persona que la recibe la acepta o la rechaza; cualquiera de las dos la borra
    // (cancelar una solicitud o eliminar a un amigo).
    match /fl_friend_requests/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.users == [request.auth.uid, request.resource.data.to]
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['from', 'to', 'users', 'status', 'fromName', 'fromPhoto', 'fromUsername',
             'toName', 'toPhoto', 'toUsername', 'createdAt'])
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 60
        && request.resource.data.toName is string && request.resource.data.toName.size() <= 60;
      allow update: if signedIn()
        && resource.data.to == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']);
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    // Todo lo demás queda cerrado
  }
}
